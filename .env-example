# ARQUIVO .env - Configurações de Ambiente

# ----------------------------------------------------
# 1. TOKEN DE AUTENTICAÇÃO
# Gerado nas configurações do GitHub (Personal Access Token).
# Certifique-se de que ele tenha a permissão 'repo' marcada.
GITHUB_TOKEN="<SEU_PERSONAL_ACCESS_TOKEN_AQUI>"

# ----------------------------------------------------
# 2. INFORMAÇÕES DO REPOSITÓRIO
# Formato: <NOME_DO_USUARIO_OU_ORG>/<NOME_DO_REPOSITORIO>
# Exemplo: meuusuario/projeto-automacao
REPO_NAME="<SEU_USUARIO>/<SEU_REPOSITORIO>"

# ----------------------------------------------------
# 3. NOME DO ARQUIVO DE BACKLOG
# Mantenha como está se você usou o nome sugerido.
BACKLOG_FILE="backlog.md"